generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Les 9 modules de l'espace de gestion (ordre du menu)
enum Module {
  MEMBRES
  ACTUALITES
  GALERIE
  ACTIONS
  FINANCES
  ARCHIVES
  ADMINISTRATION
  TEXTES
  MESSAGES
}

// Rôle de compte, modifiable depuis Administration (seul le rôle super admin a des pouvoirs réservés)
model Role {
  id          Int              @id @default(autoincrement())
  nom         String           @unique
  superAdmin  Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    Int
  module    Module
  voir      Boolean @default(false)
  creer     Boolean @default(false)
  modifier  Boolean @default(false)
  supprimer Boolean @default(false)
  exporter  Boolean @default(false)

  @@id([roleId, module])
}

// Permission personnalisée d'un compte (null = reprend celle du rôle)
model UserPermission {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  module    Module
  voir      Boolean?
  creer     Boolean?
  modifier  Boolean?
  supprimer Boolean?
  exporter  Boolean?

  @@id([userId, module])
}

// Journal des actions sensibles : qui, quoi, quand, d'où
model AuditLog {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  entite    String?
  entiteId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Paramètres internes (non affichés sur le site public)
model Parametres {
  id               Int      @id @default(1)
  adresseFondation String? // pied de page des rapports PDF
  tauxUsdCdf       Decimal? @db.Decimal(14, 4) // 1 USD = x CDF, pour les totaux convertis uniquement
}

enum Sexe {
  F
  M
}

enum Categorie {
  MAMAN
  PAPA
  JEUNE
  PASTEUR
}

enum StatutMembre {
  EN_ATTENTE
  ACTIF
  SUSPENDU
}

enum TypeMedia {
  PHOTO
  VIDEO
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  passwordHash       String
  role               Role             @relation(fields: [roleId], references: [id])
  roleId             Int
  photo              String? // obligatoire à la création ; demandé à la connexion pour les anciens comptes
  permissions        UserPermission[]
  audits             AuditLog[]
  failedLogins       Int              @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime         @default(now())
  dons               Don[]            @relation("DonsSaisis")
  donsAnnules        Don[]            @relation("DonsAnnules")
  depenses           Depense[]        @relation("DepensesSaisies")
  depensesAnnulees   Depense[]        @relation("DepensesAnnulees")
  paiements          Paiement[]       @relation("PaiementsValides")
  paiementsAnnules   Paiement[]       @relation("PaiementsAnnules")
  remunerations      MembreRemunere[] @relation("RemunerationsDesignees")
  archives           Archive[]        @relation("ArchivesImportees")
  archivesSupprimees Archive[]        @relation("ArchivesSupprimees")
  fonds              FondsMensuel[]   @relation("FondsDeclares")
}

model Commune {
  id      Int      @id @default(autoincrement())
  nom     String   @unique
  membres Member[]
}

model Member {
  id               String       @id @default(cuid())
  numero           Int          @unique @default(autoincrement()) // affiché FOGEKO-0001
  nom              String
  postNom          String?
  prenom           String
  sexe             Sexe
  dateNaissance    DateTime?
  telephone        String       @unique
  email            String?
  commune          Commune      @relation(fields: [communeId], references: [id])
  communeId        Int
  quartier         String
  profession       String?
  categorie        Categorie
  egliseMinistere  String?
  photo            String // chemin relatif dans UPLOAD_DIR (400x400 webp)
  photoThumb       String // miniature 96x96 webp
  dateAdhesion     DateTime     @default(now())
  statut           StatutMembre @default(EN_ATTENTE)
  consentement     Boolean
  consentementDate DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  dons         Don[]
  remuneration MembreRemunere?

  @@index([nom, prenom])
  @@index([categorie])
  @@index([statut])
  @@index([communeId]) // filtres et graphique par commune
  @@index([dateAdhesion]) // nouvelles adhésions, graphique par semaine
}

// Une seule ligne (id = 1) : textes et chiffres modifiables depuis l'admin
model SiteSettings {
  id            Int     @id @default(1)
  heroTitre     String
  heroSousTitre String
  statMembres   Int
  statCommunes  Int
  statActions   Int
  mission       String
  vision        String
  valeurs       String
  fondateurBio  String
  whatsapp      String
  telephone     String
  email         String
  adresse       String
  facebook      String?
  youtube       String?
  tiktok        String?
  instagram     String?
}

model TimelineEvent {
  id    Int    @id @default(autoincrement())
  annee String
  titre String
  texte String
  ordre Int    @default(0)
}

model Action {
  id      Int     @id @default(autoincrement())
  titre   String
  slug    String  @unique
  resume  String
  contenu String
  image   String
  ordre   Int     @default(0)
  publiee Boolean @default(true)
}

model NewsCategory {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  slug     String    @unique
  visible  Boolean   @default(true)
  articles Article[]
}

model Article {
  id          Int          @id @default(autoincrement())
  titre       String
  slug        String       @unique
  categorie   NewsCategory @relation(fields: [categorieId], references: [id])
  categorieId Int
  image       String
  extrait     String
  contenu     String
  publieLe    DateTime     @default(now())
  publie      Boolean      @default(false)

  @@index([publie, publieLe])
  @@index([categorieId])
}

model GalleryItem {
  id       Int       @id @default(autoincrement())
  type     TypeMedia
  titre    String
  image    String? // pour PHOTO
  videoUrl String? // YouTube/Facebook pour VIDEO
  date     DateTime  @default(now())
  ordre    Int       @default(0)
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  nom       String
  telephone String?
  email     String?
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Membres de l'administration de la fondation, publiés sur la page /administration
model Dirigeant {
  id        Int      @id @default(autoincrement())
  nom       String
  postNom   String?
  prenom    String
  poste     String // ex. Coordonnateur, Secrétaire général, Trésorière…
  photo     String // URL publique /media/… (ou /img/…)
  ordre     Int      @default(0)
  publie    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([publie, ordre])
}

enum Devise {
  USD
  CDF
}

enum MoyenPaiement {
  ESPECES
  MPESA
  AIRTEL_MONEY
  ORANGE_MONEY
  BANQUE
}

enum TypeDonateur {
  MEMBRE
  PASTEUR
  EXTERNE
  ANONYME
}

enum CategorieDepense {
  ACTION_SOCIALE
  EVENEMENT
  COMMUNICATION
  TRANSPORT
  FONCTIONNEMENT
  REMUNERATIONS
  AUTRE
}

enum Periodicite {
  MENSUEL
  TRIMESTRIEL
  PONCTUEL
}

enum PeriodeBudget {
  MENSUEL
  ANNUEL
}

enum CategorieArchive {
  ADMINISTRATIF
  FINANCIER
  JURIDIQUE
  EVENEMENT
  AUTRE
}

// Don reçu (entrée d'argent) ; jamais supprimé : annulé avec motif
model Don {
  id              Int           @id @default(autoincrement())
  numeroRecu      String        @unique // REC-2026-0001
  date            DateTime
  montant         Decimal       @db.Decimal(14, 2)
  devise          Devise
  typeDonateur    TypeDonateur
  membre          Member?       @relation(fields: [membreId], references: [id])
  membreId        String?
  donateur        String? // nom pour pasteur / externe
  telephone       String?
  moyen           MoyenPaiement
  reference       String? // n° de transaction mobile money, bordereau bancaire…
  motif           String?
  note            String?
  preuve          Archive?      @relation("PreuvesDons", fields: [preuveId], references: [id])
  preuveId        Int?
  saisiPar        User          @relation("DonsSaisis", fields: [saisiParId], references: [id])
  saisiParId      String
  createdAt       DateTime      @default(now())
  annuleLe        DateTime?
  annulePar       User?         @relation("DonsAnnules", fields: [annuleParId], references: [id])
  annuleParId     String?
  motifAnnulation String?

  @@index([date])
}

// Dépense (sortie d'argent) ; jamais supprimée : annulée avec motif
model Depense {
  id              Int              @id @default(autoincrement())
  date            DateTime
  montant         Decimal          @db.Decimal(14, 2)
  devise          Devise
  categorie       CategorieDepense
  beneficiaire    String
  description     String
  justificatif    Archive?         @relation("JustificatifsDepenses", fields: [justificatifId], references: [id])
  justificatifId  Int?
  saisiPar        User             @relation("DepensesSaisies", fields: [saisiParId], references: [id])
  saisiParId      String
  createdAt       DateTime         @default(now())
  annuleLe        DateTime?
  annulePar       User?            @relation("DepensesAnnulees", fields: [annuleParId], references: [id])
  annuleParId     String?
  motifAnnulation String?

  @@index([date])
}

// Budget par catégorie de dépense (alerte en cas de dépassement)
model Budget {
  id        Int              @id @default(autoincrement())
  categorie CategorieDepense
  devise    Devise
  periode   PeriodeBudget
  montant   Decimal          @db.Decimal(14, 2)

  @@unique([categorie, devise, periode])
}

// Membre rémunéré : désigné uniquement par un super admin
model MembreRemunere {
  id           Int         @id @default(autoincrement())
  membre       Member      @relation(fields: [membreId], references: [id])
  membreId     String      @unique
  fonction     String
  montant      Decimal     @db.Decimal(14, 2)
  devise       Devise
  periodicite  Periodicite
  debut        DateTime    @db.Date // 1er mois concerné
  actif        Boolean     @default(true)
  designePar   User        @relation("RemunerationsDesignees", fields: [designeParId], references: [id])
  designeParId String
  createdAt    DateTime    @default(now())
  paiements    Paiement[]
}

// Paiement d'un membre rémunéré ; génère un bordereau numéroté ; annulé avec motif, jamais supprimé
model Paiement {
  id              Int            @id @default(autoincrement())
  numeroBordereau String         @unique // BOR-2026-0001
  remunere        MembreRemunere @relation(fields: [remunereId], references: [id])
  remunereId      Int
  date            DateTime
  periode         String // « 2026-10 »
  montant         Decimal        @db.Decimal(14, 2)
  devise          Devise
  moyen           MoyenPaiement
  reference       String?
  preuve          Archive?       @relation("PreuvesPaiements", fields: [preuveId], references: [id])
  preuveId        Int?
  validePar       User           @relation("PaiementsValides", fields: [valideParId], references: [id])
  valideParId     String
  createdAt       DateTime       @default(now())
  annuleLe        DateTime?
  annulePar       User?          @relation("PaiementsAnnules", fields: [annuleParId], references: [id])
  annuleParId     String?
  motifAnnulation String?

  @@index([periode])
}

// Numérotation sans trou ni doublon (REC-2026, BOR-2026…)
model Compteur {
  cle    String @id
  valeur Int    @default(0)
}

// Document archivé (PDF ou photo) ; stocké hors du dossier public, servi après contrôle des droits
model Archive {
  id               Int              @id @default(autoincrement())
  titre            String
  categorie        CategorieArchive
  dateDocument     DateTime?        @db.Date
  description      String?
  motsCles         String[]
  fichier          String // chemin relatif dans UPLOAD_DIR/archives
  nomOriginal      String
  mime             String
  taille           Int
  importePar       User             @relation("ArchivesImportees", fields: [importeParId], references: [id])
  importeParId     String
  createdAt        DateTime         @default(now())
  supprimeeLe      DateTime?
  supprimeePar     User?            @relation("ArchivesSupprimees", fields: [supprimeeParId], references: [id])
  supprimeeParId   String?
  motifSuppression String?
  dons             Don[]            @relation("PreuvesDons")
  depenses         Depense[]        @relation("JustificatifsDepenses")
  paiements        Paiement[]       @relation("PreuvesPaiements")

  @@index([categorie])
  @@index([createdAt])
}

// Fonds déclaré chaque mois par un super administrateur (un par mois et par devise)
model FondsMensuel {
  id           Int      @id @default(autoincrement())
  mois         DateTime @db.Date // 1er jour du mois
  montant      Decimal  @db.Decimal(14, 2)
  devise       Devise
  note         String?
  declarePar   User     @relation("FondsDeclares", fields: [declareParId], references: [id])
  declareParId String
  updatedAt    DateTime @updatedAt

  @@unique([mois, devise])
}
